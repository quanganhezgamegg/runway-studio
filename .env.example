# Sao chep thanh .env roi dien key that. File .env da nam trong .gitignore.
RUNWAY_API_KEY=key_thay_bang_key_cua_ban

# Chi can khi dung Cloudflare Tunnel
TUNNEL_TOKEN=

# Chi can khi nen tang chi cho gan mot volume (vd: Railway).
# Gan volume vao /app/data roi bo dong duoi day de outputs nam trong volume do.
# OUTPUTS_DIR=/app/data/outputs

# Dat co dinh khi deploy hosted, neu khong moi lan deploy lai la moi nguoi bi dang xuat.
# Sinh bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
